{
  "name": "dev-oidc",
  "version": "0.5.0",
  "description": "A minimal, config-driven OIDC provider for local development.",
  "keywords": [
    "auth",
    "auth-server",
    "authentication",
    "developer-tools",
    "dev",
    "development",
    "identity-provider",
    "idp",
    "jwt",
    "local-development",
    "mock",
    "mock-oidc",
    "oauth",
    "oauth2",
    "oauth2-server",
    "oidc",
    "oidc-provider",
    "openid",
    "openid-connect",
    "pkce",
    "sso",
    "testing",
    "testing-tools"
  ],
  "homepage": "https://github.com/camcima/dev-oidc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camcima/dev-oidc.git"
  },
  "bugs": {
    "url": "https://github.com/camcima/dev-oidc/issues"
  },
  "license": "MIT",
  "author": "dev-oidc contributors",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dev-oidc": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts start --config ./examples/config.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "prettier --write '**/*.{ts,js,json,md,yml,yaml}' '!**/dist/**' '!**/node_modules/**' '!**/coverage/**' '!**/package-lock.json'",
    "format:check": "prettier --check '**/*.{ts,js,json,md,yml,yaml}' '!**/dist/**' '!**/node_modules/**' '!**/coverage/**' '!**/package-lock.json'",
    "prepare": "lefthook install",
    "release": "release-it",
    "release:alpha": "release-it prerelease --preRelease=alpha",
    "release:dry": "release-it --dry-run",
    "release:docker": "gh workflow run release-docker.yml -f tag=v$(node -p \"require('./package.json').version\")",
    "release:all": "npm run release && npm run release:docker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-report.junit.xml"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.1",
    "@httptoolkit/httpolyglot": "^3.0.1",
    "chokidar": "^5.0.0",
    "fastify": "^5.11.0",
    "jose": "^6.2.5",
    "pino": "^10.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "release-it": "^21.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
